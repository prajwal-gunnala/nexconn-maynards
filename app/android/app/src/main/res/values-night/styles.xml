<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same brand splash in dark mode (Android 7-11); the app itself is light-only. -->
    <!-- LaunchTheme: shown while the process starts and until Flutter draws its first frame, which is the
         splash overlay (lib/features/splash/splash_screen.dart) drawing the same basket in the same place. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/brand_tomato</item>
        <item name="android:navigationBarColor">@color/brand_tomato</item>
    </style>
    <!-- NormalTheme: the window behind the Flutter UI once it is running. The app canvas colour, so nothing
         white or black flashes between the splash and the first screen. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_canvas</item>
    </style>
</resources>
