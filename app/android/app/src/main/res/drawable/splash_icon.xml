<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon (windowSplashScreenAnimatedIcon): the basket (three bowl segments + handle) on a 240 dp canvas.
     Paths are mark.svg's (512 units, before its -10 shift) with the glyph's visual centre (256, 266) moved to the canvas centre and
     scaled 170/512, so the whole glyph stays within a 72 dp radius, inside the 160 dp visible circle.
     Same size/position as splash_logo.png and the Flutter splash overlay (kSplashArtExtent = 170). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">
    <group
        android:pivotX="256"
        android:pivotY="266"
        android:scaleX="0.33203125"
        android:scaleY="0.33203125"
        android:translateX="-136"
        android:translateY="-146">
        <path
            android:pathData="M140 210A116 116 0 0 1 372 210"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="30"
            android:strokeLineCap="round" />
    </group>
</vector>
